# Terraform state
*.tfstate
*.tfstate.backup
.terraform/

# Variables with secrets
terraform.tfvars
# Local backups written by scripts/tfvars.sh pull (timestamped; plain .bak is
# the legacy name written before backups were made per-pull)
terraform.tfvars.*.bak
terraform.tfvars.bak

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan files
*.tfplan

# Go build artifacts (from direct `go build` in lambda-src/)
lambda-src/*/api-handler
lambda-src/*/email-parser
lambda-src/*/bootstrap
